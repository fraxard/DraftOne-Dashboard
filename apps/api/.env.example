# ============================================================
# Draftone Dashboard API — Environment Configuration Example
# ============================================================

# Runtime Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/draftone_dev

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication Secrets (minimum 32 characters required in production)
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_char_secret_for_access
JWT_REFRESH_SECRET=replace_with_a_secure_random_32_char_secret_for_refresh

# Redis Cache & Queues (Optional in local development)
REDIS_URL=redis://localhost:6379