// Minimal Prisma configuration foundation for Draftone Dashboard API.
// Complete domain models (Organization, User, Client, Project, Task, Invoice, Asset, AuditLog)
// will be defined in the dedicated database modeling step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal model to allow Prisma Client generation without premature business modeling
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("_health_check")
}